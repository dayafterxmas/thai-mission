{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "README.md", "*.zip"],
    "headers": [
      { "source": "**/*.@(woff2|webp|svg|jpg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "**/*.@(html|css|js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
